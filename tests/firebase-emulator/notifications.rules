rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Isolated candidate contract for notifications only.
    // This file is a test fixture, not the production Firestore Rules file.
    match /users/{uid}/notifications/{notificationId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow get, list: if isOwner();
      // Notifications are server-created. Browser clients may only move the
      // read flag from false to true; all event metadata stays immutable.
      allow create, delete: if false;
      allow update: if isOwner() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['read']) &&
        resource.data.read == false &&
        request.resource.data.read == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
