        (countries.size() <= 1 || isValidMovieCountry(countries[1])) &&
        (countries.size() <= 2 || isValidMovieCountry(countries[2])) &&
        (countries.size() <= 3 || isValidMovieCountry(countries[3])) &&
        (countries.size() <= 4 || isValidMovieCountry(countries[4])) &&
        (countries.size() <= 5 || isValidMovieCountry(countries[5])) &&
        (countries.size() <= 6 || isValidMovieCountry(countries[6])) &&
        (countries.size() <= 7 || isValidMovieCountry(countries[7])) &&
        (countries.size() <= 8 || isValidMovieCountry(countries[8])) &&
        (countries.size() <= 9 || isValidMovieCountry(countries[9])) &&
        (countries.size() <= 10 || isValidMovieCountry(countries[10])) &&
        (countries.size() <= 11 || isValidMovieCountry(countries[11])) &&
        (countries.size() <= 12 || isValidMovieCountry(countries[12])) &&
        (countries.size() <= 13 || isValidMovieCountry(countries[13])) &&
        (countries.size() <= 14 || isValidMovieCountry(countries[14])) &&
        (countries.size() <= 15 || isValidMovieCountry(countries[15])) &&
        (countries.size() <= 16 || isValidMovieCountry(countries[16])) &&
        (countries.size() <= 17 || isValidMovieCountry(countries[17])) &&
        (countries.size() <= 18 || isValidMovieCountry(countries[18])) &&
        (countries.size() <= 19 || isValidMovieCountry(countries[19])) &&
        (countries.size() <= 20 || isValidMovieCountry(countries[20])) &&
        (countries.size() <= 21 || isValidMovieCountry(countries[21])) &&
        (countries.size() <= 22 || isValidMovieCountry(countries[22])) &&
        (countries.size() <= 23 || isValidMovieCountry(countries[23])) &&
        (countries.size() <= 24 || isValidMovieCountry(countries[24])) &&
        (countries.size() <= 25 || isValidMovieCountry(countries[25])) &&
        (countries.size() <= 26 || isValidMovieCountry(countries[26])) &&
        (countries.size() <= 27 || isValidMovieCountry(countries[27])) &&
        (countries.size() <= 28 || isValidMovieCountry(countries[28])) &&
        (countries.size() <= 29 || isValidMovieCountry(countries[29]));
    }
    function isValidMovieDate(value) {
      return value == '' || (value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'));
    }
    function isValidMovie(data) {
      return data is map &&
        data.keys().hasAll(['movieId', 'title', 'status', 'notes', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['movieId', 'title', 'originalTitle', 'overview', 'poster', 'backdrop', 'voteAverage', 'voteCount', 'rating', 'releaseDate', 'genreIds', 'runtime', 'tagline', 'budget', 'productionCountries', 'status', 'userRating', 'review', 'notes', 'createdAt', 'updatedAt']) &&
        data.movieId is int && data.movieId >= 1 && data.movieId <= 1000000000 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
        data.status in ['to_watch', 'watched'] && data.notes is string && data.notes.size() <= 4000 &&
        (!('originalTitle' in data) || (data.originalTitle is string && data.originalTitle.size() <= 200)) &&
        (!('overview' in data) || (data.overview is string && data.overview.size() <= 5000)) &&
        (!('poster' in data) || data.poster == null || (data.poster is string && data.poster.size() <= 2048 && data.poster.matches('^https://.*'))) &&
        (!('backdrop' in data) || data.backdrop == null || (data.backdrop is string && data.backdrop.size() <= 2048 && data.backdrop.matches('^https://.*'))) &&
        (!('voteAverage' in data) || (data.voteAverage is number && data.voteAverage >= 0 && data.voteAverage <= 10)) &&
        (!('voteCount' in data) || (data.voteCount is int && data.voteCount >= 0 && data.voteCount <= 1000000000)) &&
        (!('rating' in data) || (data.rating is number && data.rating >= 0 && data.rating <= 10)) &&
        (!('releaseDate' in data) || isValidMovieDate(data.releaseDate)) &&
        (!('genreIds' in data) || isValidMovieGenres(data.genreIds)) &&
        (!('runtime' in data) || (data.runtime is int && data.runtime >= 0 && data.runtime <= 1000)) &&
        (!('tagline' in data) || (data.tagline is string && data.tagline.size() <= 300)) &&
        (!('budget' in data) || (data.budget is int && data.budget >= 0 && data.budget <= 100000000000)) &&
        (!('productionCountries' in data) || isValidMovieCountries(data.productionCountries)) &&
        (!('userRating' in data) || (data.userRating is int && data.userRating >= 0 && data.userRating <= 5)) &&
        (!('review' in data) || (data.review is string && data.review.size() <= 4000)) &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function isValidRestaurantDishes(dishes) {
      return dishes is list && dishes.size() <= 20 &&
        (dishes.size() <= 0 || (dishes[0] is string && dishes[0].size() > 0 && dishes[0].size() <= 80)) &&
        (dishes.size() <= 1 || (dishes[1] is string && dishes[1].size() > 0 && dishes[1].size() <= 80)) &&
        (dishes.size() <= 2 || (dishes[2] is string && dishes[2].size() > 0 && dishes[2].size() <= 80)) &&
        (dishes.size() <= 3 || (dishes[3] is string && dishes[3].size() > 0 && dishes[3].size() <= 80)) &&
        (dishes.size() <= 4 || (dishes[4] is string && dishes[4].size() > 0 && dishes[4].size() <= 80)) &&
        (dishes.size() <= 5 || (dishes[5] is string && dishes[5].size() > 0 && dishes[5].size() <= 80)) &&
        (dishes.size() <= 6 || (dishes[6] is string && dishes[6].size() > 0 && dishes[6].size() <= 80)) &&
        (dishes.size() <= 7 || (dishes[7] is string && dishes[7].size() > 0 && dishes[7].size() <= 80)) &&
        (dishes.size() <= 8 || (dishes[8] is string && dishes[8].size() > 0 && dishes[8].size() <= 80)) &&
        (dishes.size() <= 9 || (dishes[9] is string && dishes[9].size() > 0 && dishes[9].size() <= 80)) &&
        (dishes.size() <= 10 || (dishes[10] is string && dishes[10].size() > 0 && dishes[10].size() <= 80)) &&
        (dishes.size() <= 11 || (dishes[11] is string && dishes[11].size() > 0 && dishes[11].size() <= 80)) &&
        (dishes.size() <= 12 || (dishes[12] is string && dishes[12].size() > 0 && dishes[12].size() <= 80)) &&
        (dishes.size() <= 13 || (dishes[13] is string && dishes[13].size() > 0 && dishes[13].size() <= 80)) &&
        (dishes.size() <= 14 || (dishes[14] is string && dishes[14].size() > 0 && dishes[14].size() <= 80)) &&
        (dishes.size() <= 15 || (dishes[15] is string && dishes[15].size() > 0 && dishes[15].size() <= 80)) &&
        (dishes.size() <= 16 || (dishes[16] is string && dishes[16].size() > 0 && dishes[16].size() <= 80)) &&
        (dishes.size() <= 17 || (dishes[17] is string && dishes[17].size() > 0 && dishes[17].size() <= 80)) &&
        (dishes.size() <= 18 || (dishes[18] is string && dishes[18].size() > 0 && dishes[18].size() <= 80)) &&
        (dishes.size() <= 19 || (dishes[19] is string && dishes[19].size() > 0 && dishes[19].size() <= 80));
    }
    function isValidRestaurantPhotos(photos) {
      return photos is list && photos.size() <= 10 &&
        (photos.size() <= 0 || (photos[0] is string && photos[0].size() <= 2048 && photos[0].matches('^https://.*'))) &&
        (photos.size() <= 1 || (photos[1] is string && photos[1].size() <= 2048 && photos[1].matches('^https://.*'))) &&
        (photos.size() <= 2 || (photos[2] is string && photos[2].size() <= 2048 && photos[2].matches('^https://.*'))) &&
        (photos.size() <= 3 || (photos[3] is string && photos[3].size() <= 2048 && photos[3].matches('^https://.*'))) &&
        (photos.size() <= 4 || (photos[4] is string && photos[4].size() <= 2048 && photos[4].matches('^https://.*'))) &&
        (photos.size() <= 5 || (photos[5] is string && photos[5].size() <= 2048 && photos[5].matches('^https://.*'))) &&
        (photos.size() <= 6 || (photos[6] is string && photos[6].size() <= 2048 && photos[6].matches('^https://.*'))) &&
        (photos.size() <= 7 || (photos[7] is string && photos[7].size() <= 2048 && photos[7].matches('^https://.*'))) &&
        (photos.size() <= 8 || (photos[8] is string && photos[8].size() <= 2048 && photos[8].matches('^https://.*'))) &&
        (photos.size() <= 9 || (photos[9] is string && photos[9].size() <= 2048 && photos[9].matches('^https://.*')));
    }
    function isValidRestaurantDate(value) {
      return value == null || (value is string && (value == '' || value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')));
    }
    function isValidRestaurant(data) {
      return data is map &&
        data.keys().hasAll(['name', 'cuisine', 'status', 'notes', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['name', 'cuisine', 'status', 'address', 'visitDate', 'avgBill', 'userRating', 'favoriteDishes', 'review', 'photos', 'notes', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 160 &&
        data.cuisine in ['', 'Итальянская', 'Японская', 'Русская', 'Французская', 'Мексиканская', 'Китайская', 'Индийская', 'Грузинская'] &&
        data.status in ['want_to_visit', 'visited'] && data.notes is string && data.notes.size() <= 4000 &&
        (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
        (!('visitDate' in data) || isValidRestaurantDate(data.visitDate)) &&
        (!('avgBill' in data) || (data.avgBill is int && data.avgBill >= 0 && data.avgBill <= 10000000)) &&
        (!('userRating' in data) || (data.userRating is int && data.userRating >= 0 && data.userRating <= 10)) &&
        (!('favoriteDishes' in data) || isValidRestaurantDishes(data.favoriteDishes)) &&
        (!('review' in data) || (data.review is string && data.review.size() <= 4000)) &&
        (!('photos' in data) || isValidRestaurantPhotos(data.photos)) &&
        data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      allow create: if false && isOwner(uid) && uidUnchanged(uid) &&
        isValidUser(request.resource.data);
      allow update: if isOwner(uid) && uidNotModified() &&
        isValidUser(request.resource.data) &&
        isValidProfileEdit(request.resource.data);
      allow delete: if false;


      match /dreams/{dreamId} {
        allow create: if isOwner(uid) &&
          exists(/databases/$(database)/documents/users/$(uid)) &&
          isValidDream(request.resource.data) &&
          (!('isPublic' in request.resource.data) || request.resource.data.isPublic == false) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid) &&
          isValidDream(request.resource.data) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          ((!('isPublic' in resource.data) &&
            !('isPublic' in request.resource.data)) ||
           (('isPublic' in resource.data) &&
            request.resource.data.isPublic == resource.data.isPublic)) &&
          request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
      }


      match /travels/{travelId} {
        allow create: if isOwner(uid) &&
          exists(/databases/$(database)/documents/users/$(uid)) &&
          isValidTravel(request.resource.data) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid) &&
          isValidTravel(request.resource.data) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
      }


      match /books/{bookId} {
        allow create: if isOwner(uid) &&
          exists(/databases/$(database)/documents/users/$(uid)) &&
          isValidBook(request.resource.data) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid) &&
          isValidBook(request.resource.data) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
      }

      match /movies/{movieId} {
        allow create: if isOwner(uid) && exists(/databases/$(database)/documents/users/$(uid)) &&
          isValidMovie(request.resource.data) && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid) && isValidMovie(request.resource.data) &&
          request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
      }
      match /restaurants/{restaurantId} {
        allow create: if isOwner(uid) && exists(/databases/$(database)/documents/users/$(uid)) &&
          isValidRestaurant(request.resource.data) && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if isOwner(uid) && isValidRestaurant(request.resource.data) &&
          request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner(uid);
      }
      match /{category}/{id} {
        allow get, list: if isOwner(uid) &&
          category in [
            'travels', 'restaurants', 'movies', 'books', 'dreams',
            'dailyTasks', 'notifications', 'friends',
            'friendRequests', 'sentRequests', 'chats', 'messages'
          ] &&
          exists(/databases/$(database)/documents/users/$(uid));
        allow create: if false && isOwner(uid) &&
          isValidOwnedDocument(request.resource.data);
        allow update: if false && isOwner(uid) &&
          isValidOwnedDocument(request.resource.data);
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
