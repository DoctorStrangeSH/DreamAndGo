// Test-only candidate rules for the proposed chats/{chatId} membership model.
// Never deploy this file: all unrelated collections are deliberately denied.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function participant(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }
    function activeChat(chatId) {
      return participant(chatId) &&
        get(/databases/$(database)/documents/chats/$(chatId)).data.state == 'active';
    }
    match /chats/{chatId} {
      allow get: if participant(chatId);
      allow list, create, update, delete: if false; // Admin-backed lifecycle only.
      match /messages/{messageId} {
        allow get, list: if participant(chatId);
        allow create: if activeChat(chatId) &&
          request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt', 'read', 'edited']) &&
          request.resource.data.keys().hasAll(['senderId', 'text', 'createdAt', 'read', 'edited']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.read == false &&
          request.resource.data.edited == false;
        allow update: if activeChat(chatId) &&
          resource.data.senderId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'editedAt']) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.edited == true &&
          request.resource.data.editedAt == request.time;
        allow delete: if activeChat(chatId) && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
