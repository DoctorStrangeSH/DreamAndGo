rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All client access is denied by default. Trusted Firebase Admin SDK
    // Functions bypass Firestore Security Rules and enforce authorization
    // inside their callable handlers. Expand client access only with audited,
    // path-specific rules and emulator tests.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
